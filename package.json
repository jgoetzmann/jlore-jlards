{
  "name": "jlore-jlards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim-cli.ts",
    "balance": "tsx tools/balance-report.ts",
    "cards:validate": "tsx tools/validate-cards.ts",
    "cards:export": "tsx tools/export-cards.ts",
    "art:manifest": "tsx tools/art-manifest.ts",
    "replay": "tsx tools/replay.ts",
    "relay:check": "tsx tools/relay-check.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@upstash/redis": "1.34.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
